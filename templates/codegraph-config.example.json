{
  "projectName": "project",
  "outputDir": ".project-map",
  "scanRoots": [
    "src",
    "app",
    "pages",
    "components",
    "lib",
    "server",
    "scripts",
    "tests",
    "docs",
    ".github"
  ],
  "rootFiles": [
    "package.json",
    "tsconfig.json",
    "next.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    ".env.example",
    ".gitignore",
    "CLAUDE.md"
  ],
  "ignoreSegments": [
    ".git",
    ".next",
    ".project-map",
    "artifacts",
    "coverage",
    "dist",
    "node_modules",
    "playwright-report",
    "test-results"
  ],
  "accessSurfaces": {
    "public": [],
    "userPrivate": [],
    "adminPrivate": [],
    "monitoringPrivate": [],
    "system": []
  },
  "features": {
    "incrementalScanCache": true,
    "preflight": true,
    "mcpStdio": false,
    "graphView": true,
    "handoffPackets": true,
    "tokenIntelligence": true
  },
  "preflight": {
    "defaultContextFiles": [
      ".project-map/ai-context.md",
      ".project-map/codex-context.md",
      ".project-map/claude-context.md",
      ".project-map/access-matrix.md",
      ".project-map/test-plan.md",
      "docs/README.md",
      "docs/roadmap.md"
    ],
    "blockOnP0Impact": true,
    "maxRequiredFiles": 40
  },
  "ci": {
    "maxBlockers": 0,
    "maxWarnings": 0
  }
}
